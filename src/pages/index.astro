---
import CrtLayout from '../layouts/CrtLayout.astro';
import PixelIcon from '../components/PixelIcon.astro';

const menu = [
  { label: 'About me', href: '/about', icon: 'user' as const },
  { label: 'Blog', href: '/blog', icon: 'scroll' as const },
  { label: 'GitHub', href: 'https://github.com/Prakhargoel8c', icon: 'github' as const, external: true },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/prakgoel89', icon: 'linkedin' as const, external: true },
];
---

<CrtLayout title="Prakhar Goel — Press Start">
  <main class="title-screen">
    <div class="meteors" aria-hidden="true">
      <span class="meteor m1"></span>
      <span class="meteor m2"></span>
      <span class="meteor m3"></span>
      <span class="meteor m4"></span>
    </div>
    <header class="hud-corners pixel" aria-hidden="true">
      <span class="up">1up</span>
      <span class="up right">2up</span>
    </header>

    <section class="hi-score pixel" aria-label="High score">
      <span class="hi-label">AI tokens spent</span>
      <span class="hi-value" id="score">73795159</span>
      <span class="hi-sub">Hi-score</span>
    </section>

    <h1 class="amber-title name">Prakhar<br />Goel</h1>
    <p class="tagline pixel">Full-stack engineer</p>

    <nav class="menu pixel" aria-label="Main menu">
      <ul id="menu-list">
        {
          menu.map((item, i) => (
            <li>
              <a
                href={item.href}
                data-index={i}
                class="icon-trigger"
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener' : undefined}
              >
                <span class="cursor" aria-hidden="true">
                  &#9658;
                </span>
                <PixelIcon name={item.icon} />
                {item.label}
                {item.external && <span aria-hidden="true"> &#8599;</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="brawl" aria-hidden="true">
      <!-- Groovy ghost -->
      <svg class="mon mon-a" viewBox="0 0 72 72" fill="none">
        <path
          d="M36 6C23 6 16 17 16 30v26c0 0 3.5-4.5 7-4.5S26.5 56 30 56s3.5-4.5 7-4.5S40.5 56 44 56s3.5-4.5 7-4.5 5 4.5 5 4.5V30C56 17 49 6 36 6Z"
          fill="#fff7e6" stroke="#241645" stroke-width="3" stroke-linejoin="round"/>
        <!-- arm raised for the clap -->
        <path d="M55 34c5 0 10-3 12-7" stroke="#241645" stroke-width="3" stroke-linecap="round"/>
        <path d="M67 27c2-1 3-3 3-5" stroke="#241645" stroke-width="3" stroke-linecap="round"/>
        <path d="M17 36c-4 1-7 4-8 8" stroke="#241645" stroke-width="3" stroke-linecap="round"/>
        <ellipse cx="31" cy="26" rx="3.4" ry="4.6" fill="#241645"/>
        <ellipse cx="45" cy="26" rx="3.4" ry="4.6" fill="#241645"/>
        <circle cx="32.2" cy="24.4" r="1.2" fill="#fff7e6"/>
        <circle cx="46.2" cy="24.4" r="1.2" fill="#fff7e6"/>
        <path d="M32 37c2.5 3 9.5 3 12 0" stroke="#241645" stroke-width="3" stroke-linecap="round"/>
        <path d="M25 33c1.5 1.5 4 1.5 5.5 0" stroke="#ff6b6b" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
      </svg>

      <!-- Impact star -->
      <svg class="spark" viewBox="0 0 40 40" fill="none">
        <path
          d="M20 2l4.2 11.8L36 18l-11.8 4.2L20 34l-4.2-11.8L4 18l11.8-4.2L20 2Z"
          fill="#ffd84d" stroke="#241645" stroke-width="2.5" stroke-linejoin="round"/>
        <circle cx="20" cy="18" r="2.4" fill="#241645"/>
      </svg>

      <!-- Groovy pumpkin -->
      <svg class="mon mon-b" viewBox="0 0 72 72" fill="none">
        <path d="M36 14c0-4 1-7 4-9" stroke="#241645" stroke-width="3" stroke-linecap="round"/>
        <path d="M33 15c0-3 .5-5.5 2-7.5 1 0 5-1 7 1-2 2-3 4-3 6.5Z" fill="#7ac74f" stroke="#241645" stroke-width="2.5" stroke-linejoin="round"/>
        <path
          d="M36 16c-3-1.8-7-1.8-10.5-.4C19 18.2 15 24.5 15 34c0 11 8 20 21 20s21-9 21-20c0-9.5-4-15.8-10.5-18.4C43 14.2 39 14.2 36 16Z"
          fill="#ff9838" stroke="#241645" stroke-width="3" stroke-linejoin="round"/>
        <path d="M28 17.5C25.5 22 24.5 27.5 24.5 34c0 6.5 1 12.5 3.5 16.5M44 17.5c2.5 4.5 3.5 10 3.5 16.5 0 6.5-1 12.5-3.5 16.5" stroke="#241645" stroke-width="2" stroke-linecap="round" opacity="0.55"/>
        <path d="M29 30l6 4-6 3v-7Z" fill="#241645"/>
        <path d="M43 30l-6 4 6 3v-7Z" fill="#241645" transform="translate(0 0)"/>
        <path d="M28 43c3.5 4.5 12.5 4.5 16 0" stroke="#241645" stroke-width="3" stroke-linecap="round"/>
        <path d="M32 45.5v-2M36 46.5v-2.5M40 45.5v-2" stroke="#241645" stroke-width="2" stroke-linecap="round"/>
        <!-- arm raised for the clap -->
        <path d="M56 30c5-1 8-4 9-8" stroke="#241645" stroke-width="3" stroke-linecap="round"/>
        <path d="M65 22c2-1 3-2.5 3.5-4.5" stroke="#241645" stroke-width="3" stroke-linecap="round"/>
        <path d="M16 34c-4 0-7 2-9 5" stroke="#241645" stroke-width="3" stroke-linecap="round"/>
        <path d="M28 54c-1 3-1 5 0 7M44 54c1 3 1 5 0 7" stroke="#241645" stroke-width="3" stroke-linecap="round"/>
        <ellipse cx="27" cy="63" rx="5" ry="3" fill="#fff7e6" stroke="#241645" stroke-width="2.5"/>
        <ellipse cx="45" cy="63" rx="5" ry="3" fill="#fff7e6" stroke="#241645" stroke-width="2.5"/>
      </svg>
    </div>

    <p class="press-start pixel blink" aria-hidden="true">&uarr;&darr; select &middot; enter start</p>

    <footer class="credit pixel">
      <span>Insert coin</span>
      <span>Credit &copy; 2026</span>
    </footer>
  </main>
</CrtLayout>

<style>
  .title-screen {
    position: relative;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(1.25rem, 3vh, 2.5rem) clamp(1rem, 4vw, 3rem);
  }

  /* Aceternity-style meteor shower, pixelated: square heads, stepped fall */
  .meteors {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .meteor {
    position: absolute;
    top: -10%;
    width: 6px;
    height: 6px;
    background: var(--amber-hi);
    box-shadow: 0 0 8px rgba(255, 216, 77, 0.8);
    opacity: 0;
  }

  .meteor::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 2px;
    height: 64px;
    transform: translateX(-50%);
    background: linear-gradient(0deg, rgba(255, 247, 230, 0.75), transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .meteor {
      animation: meteor-fall 5s steps(24) infinite;
    }
    .m1 { left: 12%; animation-delay: 0s; }
    .m2 { left: 38%; animation-delay: 2.2s; animation-duration: 6s; }
    .m3 { left: 64%; animation-delay: 3.6s; animation-duration: 4.5s; }
    .m4 { left: 86%; animation-delay: 1.1s; animation-duration: 7s; }

    @keyframes meteor-fall {
      0% { transform: translate(0, 0); opacity: 0; }
      5% { opacity: 1; }
      60% { opacity: 1; }
      70% { transform: translate(-16vh, 120vh); opacity: 0; }
      100% { transform: translate(-16vh, 120vh); opacity: 0; }
    }
  }

  .hud-corners {
    width: 100%;
    display: flex;
    justify-content: space-between;
    color: var(--coral);
    font-size: clamp(0.6rem, 1.6vw, 0.85rem);
  }

  .hi-score {
    margin-top: clamp(1rem, 4vh, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    color: var(--amber);
    font-size: clamp(0.65rem, 1.8vw, 0.95rem);
  }

  .hi-value {
    color: var(--text);
    font-size: clamp(0.8rem, 2.2vw, 1.15rem);
  }

  .hi-sub {
    font-family: var(--font-term);
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 1.05rem;
    color: var(--dim);
  }

  .name {
    margin-top: clamp(1.5rem, 6vh, 3.5rem);
    font-size: clamp(1.7rem, 6.5vw, 4rem);
    line-height: 1.25;
  }

  .tagline {
    margin-top: 1.4rem;
    font-size: clamp(0.55rem, 1.5vw, 0.8rem);
    color: var(--dim);
  }

  .menu {
    margin-top: clamp(1.75rem, 6vh, 3.5rem);
    font-size: clamp(0.7rem, 1.9vw, 1rem);
  }

  .menu ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    width: max-content;
    margin-inline: auto;
    text-align: left;
  }

  .menu a {
    text-decoration: none;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.75em;
    padding: 0.2rem 0.4rem;
  }

  .cursor {
    flex: none;
    width: 1em;
    color: var(--amber);
    opacity: 0;
    transform: translateX(-0.2em);
  }

  .menu .picon {
    flex: none;
  }

  .menu a:hover .cursor,
  .menu a:focus-visible .cursor,
  .menu a.selected .cursor {
    opacity: 1;
  }

  .menu a.selected,
  .menu a:hover {
    color: var(--amber-hi);
  }

  /* Two pixel monsters brawling above the footer */
  .brawl {
    margin-top: auto;
    padding-top: 2.5rem;
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .mon {
    width: clamp(56px, 12vw, 84px);
    height: auto;
  }

  .mon-b {
    transform: scaleX(-1);
  }

  .spark {
    width: clamp(22px, 5vw, 32px);
    height: auto;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mon-a {
      animation: brawl-a 4s ease-in-out infinite;
    }
    .mon-b {
      animation: brawl-b 4s ease-in-out infinite;
    }
    .spark {
      animation: spark-hit 4s ease-out infinite;
    }

    /* bob → back away (wind-up) → charge in → clap → return */
    @keyframes brawl-a {
      0% { transform: translate(0, 0); }
      10% { transform: translate(0, -3px); }
      20% { transform: translate(0, 0); }
      30% { transform: translate(0, -3px); }
      40% { transform: translate(0, 0); }
      46% { transform: translate(-14px, 0); }
      52% { transform: translate(-22px, 1px); }
      58% { transform: translate(-22px, 0); }
      62% { transform: translate(32px, 0); }
      70% { transform: translate(32px, -2px); }
      78% { transform: translate(0, 0); }
      100% { transform: translate(0, 0); }
    }

    @keyframes brawl-b {
      0% { transform: scaleX(-1) translate(0, 0); }
      15% { transform: scaleX(-1) translate(0, -3px); }
      25% { transform: scaleX(-1) translate(0, 0); }
      35% { transform: scaleX(-1) translate(0, -3px); }
      40% { transform: scaleX(-1) translate(0, 0); }
      46% { transform: scaleX(-1) translate(-14px, 0); }
      52% { transform: scaleX(-1) translate(-22px, 1px); }
      58% { transform: scaleX(-1) translate(-22px, 0); }
      62% { transform: scaleX(-1) translate(32px, 0); }
      70% { transform: scaleX(-1) translate(32px, -2px); }
      78% { transform: scaleX(-1) translate(0, 0); }
      100% { transform: scaleX(-1) translate(0, 0); }
    }

    @keyframes spark-hit {
      0%, 60% { opacity: 0; transform: scale(0.6); }
      62% { opacity: 1; transform: scale(1); }
      68% { opacity: 1; transform: scale(1.35); }
      72% { opacity: 1; transform: scale(1); }
      76%, 100% { opacity: 0; transform: scale(0.6); }
    }
  }

  .press-start {
    padding-top: 2rem;
    color: var(--dim);
    font-size: clamp(0.5rem, 1.3vw, 0.7rem);
  }

  .credit {
    width: 100%;
    display: flex;
    justify-content: space-between;
    margin-top: 1.6rem;
    color: var(--coral);
    font-size: clamp(0.55rem, 1.5vw, 0.75rem);
  }
</style>

<script>
  // Arcade-style keyboard menu: arrows move the ► cursor, Enter follows the link.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('#menu-list a')];
  let selected = 0;

  const select = (i: number) => {
    links[selected].classList.remove('selected');
    selected = (i + links.length) % links.length;
    links[selected].classList.add('selected');
  };
  select(0);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      select(selected + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      select(selected - 1);
    } else if (e.key === 'Enter' && document.activeElement?.tagName !== 'A') {
      links[selected].click();
    }
  });

  links.forEach((link, i) => {
    link.addEventListener('mouseenter', () => select(i));
    link.addEventListener('focus', () => select(i));
  });

  // Score ticks up like an arcade counter unless the user prefers reduced motion.
  const score = document.getElementById('score')!;
  const target = 73_795_159;
  const pad = (n: number) => String(Math.floor(n)).padStart(8, '0');
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    score.textContent = pad(target);
  } else {
    const start = performance.now();
    const duration = 1600;
    const tick = (now: number) => {
      const t = Math.min((now - start) / duration, 1);
      score.textContent = pad(target * (1 - Math.pow(1 - t, 3)));
      if (t < 1) requestAnimationFrame(tick);
    };
    score.textContent = pad(0);
    requestAnimationFrame(tick);
  }
</script>
