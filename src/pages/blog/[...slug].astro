---
import { getCollection, render } from 'astro:content';
import CrtLayout from '../../layouts/CrtLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: '2-digit' });
---

<CrtLayout title={`${post.data.title} — Prakhar Goel`} description={post.data.description} hud="Now playing">
  <main class="stage">
    <article>
      <header class="post-head">
        <h1 class="amber-title post-title">{post.data.title}</h1>
        <time class="muted" datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
      </header>
      <div class="prose">
        <Content />
      </div>
      <footer class="post-foot">
        <a class="pixel" href="/blog">&#9664; Back to stage select</a>
      </footer>
    </article>
  </main>
</CrtLayout>

<style>
  .post-head {
    margin: 1rem 0 2.5rem;
    display: grid;
    gap: 1rem;
  }

  .post-title {
    font-size: clamp(1.1rem, 3.5vw, 1.9rem);
    line-height: 1.5;
  }

  .post-foot {
    margin-top: 3.5rem;
    border-top: 1px dashed rgba(160, 150, 255, 0.35);
    padding-top: 1.5rem;
  }

  .post-foot a {
    color: var(--amber);
    text-decoration: none;
    font-size: 0.65rem;
  }

  .post-foot a:hover {
    color: var(--amber-hi);
  }

  /* markdown body */
  .prose :global(h2) {
    font-family: var(--font-pixel);
    font-size: clamp(0.75rem, 2vw, 0.95rem);
    color: var(--amber);
    margin: 2.5rem 0 1rem;
    line-height: 1.7;
  }

  .prose :global(h3) {
    font-family: var(--font-pixel);
    font-size: clamp(0.65rem, 1.7vw, 0.8rem);
    color: var(--amber-hi);
    margin: 2rem 0 0.8rem;
    line-height: 1.7;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.1rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
  }

  .prose :global(a) {
    color: var(--amber);
  }

  .prose :global(blockquote) {
    border-left: 4px solid var(--coral);
    padding-left: 1.2rem;
    color: var(--dim);
    margin-bottom: 1.1rem;
  }

  .prose :global(code) {
    background: rgba(18, 11, 38, 0.6);
    padding: 0.1em 0.35em;
    font-family: var(--font-term);
  }

  .prose :global(pre) {
    background: rgba(18, 11, 38, 0.7) !important;
    border: 1px solid rgba(160, 150, 255, 0.3);
    padding: 1.2rem;
    overflow-x: auto;
    margin-bottom: 1.1rem;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
</style>
