---
import { getCollection } from 'astro:content';
import CrtLayout from '../../layouts/CrtLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: '2-digit' });
---

<CrtLayout title="Blog — Prakhar Goel" hud="Select stage">
  <main class="stage">
    <h1 class="amber-title page-title">Select stage</h1>

    {
      posts.length === 0 ? (
        <div class="panel empty">
          <p class="pixel empty-title">No saved games found</p>
          <p class="muted">New stages are in development. Check back soon.</p>
        </div>
      ) : (
        <ol class="stages">
          {posts.map((post, i) => (
            <li>
              <a class="panel stage-card" href={`/blog/${post.id}/`}>
                <span class="pixel stage-num">Stage {String(i + 1).padStart(2, '0')}</span>
                <span class="pixel stage-title">{post.data.title}</span>
                <span class="muted">{post.data.description}</span>
                <time class="muted date" datetime={post.data.pubDate.toISOString()}>
                  {fmt(post.data.pubDate)}
                </time>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </main>
</CrtLayout>

<style>
  .page-title {
    font-size: clamp(1.4rem, 4.5vw, 2.4rem);
    margin-top: 1rem;
  }

  .empty {
    text-align: center;
    padding-block: 3.5rem;
  }

  .empty-title {
    color: var(--coral);
    font-size: clamp(0.7rem, 2vw, 0.95rem);
    margin-bottom: 1rem;
  }

  .stages {
    list-style: none;
    display: grid;
    gap: 0.25rem;
    margin-top: 1.5rem;
  }

  .stage-card {
    display: grid;
    gap: 0.55rem;
    text-decoration: none;
    transition: border-color 120ms steps(2);
  }

  .stage-card:hover {
    border-color: var(--amber);
  }

  .stage-num {
    font-size: 0.55rem;
    color: var(--coral);
  }

  .stage-title {
    font-size: clamp(0.7rem, 1.8vw, 0.9rem);
    color: var(--amber-hi);
    line-height: 1.7;
  }

  .date {
    font-size: 1.05rem;
  }
</style>
