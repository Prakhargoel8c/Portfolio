---
import CrtLayout from '../layouts/CrtLayout.astro';
import PixelIcon from '../components/PixelIcon.astro';

/**
 * Career as a world map: each employer is a World, each role is a Stage
 * inside it, and projects are the loot collected in that world.
 */
const worlds = [
  {
    num: 3,
    company: 'Adalat AI',
    yc: true,
    dates: '2024 – present',
    status: 'Now playing',
    open: true,
    blurb: 'Nonprofit building voice-first infrastructure for Indian courtrooms. Backed by Y Combinator; featured in Forbes and MIT Solve.',
    stages: [
      {
        code: '3-2',
        role: 'Platform Engineer',
        dates: '2025 – present',
        notes: [
          'Promoted to a senior IC role after leading the product 0→1, focused on platform-level problems across products.',
          'Built Yak, a Yjs collaboration server on Node.js and Redis, powering real-time multi-user document editing platform-wide.',
          'Designed a lossless WebSocket pipeline for voice dictation — buffering, auto-reconnect, and resume, so no audio is dropped over flaky courtroom internet.',
          'The platform is live across 50% of India, with 1,000,000+ minutes of courtroom proceedings recorded every quarter.',
        ],
      },
      {
        code: '3-1',
        role: 'Founding Engineer',
        dates: '2024 – 2025',
        notes: [
          'First engineering hire; helped scale the nonprofit into one of India’s leading legal-tech orgs — the first nonprofit accepted into Y Combinator in 5 years.',
          'Owned the entire frontend stack — built a voice-first text editor for patchy internet, with print, page margins, and end-to-end encryption.',
          'Helped scale engineering from 0 to 20.',
        ],
      },
    ],
    loot: [
      { name: 'Judges Dashboard', desc: 'Core dashboard for judges and court staff — voice-first editor, document workflows, offline-resilient UX.' },
      { name: 'Yak', desc: 'Yjs collaboration server on Node.js + Redis behind every collaborative document on the platform.' },
    ],
  },
  {
    num: 2,
    company: 'SentiSum',
    dates: '2022 – 2024',
    status: 'Cleared',
    blurb: 'Seed-funded customer-insight startup, London (remote).',
    stages: [
      {
        code: '2-1',
        role: 'Senior MTS, Frontend',
        dates: '2022 – 2024',
        notes: [
          'Completed the 0→1 journey with complete ownership of the frontend and other key pieces of the stack.',
          'Mentored and hired junior engineers to expand the team.',
          'Retained part-time for 6 months after moving on — single-handedly maintained the product while the core team worked on a pivot.',
        ],
      },
    ],
    loot: [
      { name: 'SentiSum Dashboard', desc: 'Support-insights dashboard; designed a reusable component system from unstyled components, killed page refreshes with react-query.' },
    ],
  },
  {
    num: 1,
    company: 'Larsen & Toubro Infotech',
    dates: '2020 – 2022',
    status: 'Cleared',
    blurb: 'Microsoft SDMPlus project.',
    stages: [
      {
        code: '1-1',
        role: 'Senior Software Engineer, Full Stack',
        dates: '2020 – 2022',
        notes: [
          'Built a git-like document change tracker and approval flow with CKEditor.',
          'Worked on site gamification to increase user interaction, and on accessibility.',
        ],
      },
    ],
    loot: [
      { name: 'SDMPlus', desc: 'Upgraded an ejected project to Webpack 5; lazy-loading and react-virtualized performance work.' },
      { name: 'Rasa Bot Designer', desc: 'Chatbot workflow builder with rich-text mentions via DraftJS.' },
      { name: 'Survey Form', desc: 'Dynamic step-form builder driven by JSON data.' },
    ],
  },
];

type SkillItem = string | { label: string; new?: boolean };

const skills: { group: string; items: SkillItem[] }[] = [
  { group: 'Frontend', items: ['TypeScript', 'React', 'Next.js', 'Redux Toolkit', 'Zustand', 'React Query', 'Zod', 'Tailwind', 'Radix UI'] },
  {
    group: 'Backend & real-time',
    items: ['Node.js', 'Express', 'Redis', 'WebSockets', 'Yjs', 'PartyKit', 'Python', 'MS-SQL', 'Supabase', { label: 'Go', new: true }],
  },
  { group: 'Architecture', items: [{ label: 'System design', new: true }] },
  { group: 'Editors & collaboration', items: ['ProseMirror', 'Tiptap', 'CKEditor', 'DraftJS'] },
  { group: 'AI tooling', items: ['Claude Code', 'AI-assisted workflows', { label: 'AI/LLM integration', new: true }] },
  { group: 'Analytics & monitoring', items: ['Mixpanel', 'Sentry', 'June'] },
];

const achievements = [
  '“Building WebSocket Apps That Hold Up in Production” — React Nexus, 2026',
  '“Designing a Voice-First Text Editor” — Bangalore React Meetup #96',
  'Adalat AI — first nonprofit accepted into Y Combinator in 5 years; featured in Forbes and MIT Solve',
];
---

<CrtLayout title="About — Prakhar Goel" hud="Player status">
  <main class="stage">
    <h1 class="amber-title page-title">Player 1</h1>

    <div class="panel player-card">
      <dl>
        <div><dt class="pixel">Name</dt><dd>Prakhar Goel</dd></div>
        <div><dt class="pixel">Class</dt><dd>Full-stack engineer · frontend specialist</dd></div>
        <div><dt class="pixel">Base</dt><dd>India · remote</dd></div>
      </dl>
      <div class="xp" role="img" aria-label="Level 6, six years of experience">
        <span class="pixel xp-label">LV 6</span>
        <div class="xp-bar"><div class="xp-fill"></div></div>
        <span class="muted xp-note">6 yrs XP · grinding toward LV 7</span>
      </div>
      <p class="bio">
        I build web products end to end — from TypeScript/React SPAs to the Node.js services and
        real-time infrastructure behind them. First engineering hire at Adalat AI (YC), where I led
        the product 0→1 and was promoted to Platform Engineer. Special interest in text editors,
        real-time collaboration, and AI-based technologies.
      </p>
    </div>

    <h2 class="section-head">World map</h2>
    <p class="muted map-hint">Select a world to explore it. Stages are roles; loot is what got built there.</p>

    {
      worlds.map((w) => (
        <details class="panel world" open={w.open}>
          <summary class="icon-trigger">
            <span class="pixel world-name">
              World {w.num}: {w.company}
              {w.yc && <span class="yc-badge" title="Backed by Y Combinator">YC</span>}
            </span>
            <span class="muted world-meta">
              {w.dates} · <span class:list={['status', { active: w.status === 'Now playing' }]}>{w.status}</span>
            </span>
          </summary>

          <p class="muted world-blurb">{w.blurb}</p>

          {w.stages.map((s) => (
            <section class="stage-block">
              <h3 class="pixel stage-code">
                Stage {s.code} · {s.role}
              </h3>
              <p class="muted stage-dates">{s.dates}</p>
              <ul>
                {s.notes.map((n) => (
                  <li>{n}</li>
                ))}
              </ul>
            </section>
          ))}

          <section class="loot">
            <h3 class="pixel loot-head">Loot collected</h3>
            <ul class="loot-grid">
              {w.loot.map((p) => (
                <li>
                  <span class="pixel item-name">{p.name}</span>
                  <span class="muted">{p.desc}</span>
                </li>
              ))}
            </ul>
          </section>
        </details>
      ))
    }

    <h2 class="section-head">Skill tree</h2>
    <div class="panel">
      {
        skills.map((s) => (
          <div class="skill-row">
            <h3 class="pixel skill-group">{s.group}</h3>
            <ul class="chips">
              {s.items.map((item) =>
                typeof item === 'string' ? (
                  <li>{item}</li>
                ) : (
                  <li class:list={[{ fresh: item.new }]}>
                    {item.label}
                    {item.new && <span class="pixel new-tag blink">New!</span>}
                  </li>
                )
              )}
            </ul>
          </div>
        ))
      }
    </div>

    <h2 class="section-head">Achievements unlocked</h2>
    <div class="panel">
      <ul class="achievements">
        {achievements.map((a) => <li>{a}</li>)}
      </ul>
    </div>

    <h2 class="section-head">Tutorial complete</h2>
    <div class="panel">
      <ul class="tutorial">
        <li>B.Tech, Computer Science — UPES · 2016 – 2020</li>
        <li>Microsoft Azure Fundamentals certification · 2020</li>
      </ul>
    </div>

    <h2 class="section-head">Join party</h2>
    <div class="panel">
      <ul class="party">
        <li>
          <a class="icon-trigger" href="mailto:prakhargoel.gg@gmail.com">
            <PixelIcon name="mail" /> prakhargoel.gg@gmail.com
          </a>
        </li>
        <li>
          <a class="icon-trigger" href="https://github.com/Prakhargoel8c" target="_blank" rel="noopener">
            <PixelIcon name="github" /> github.com/Prakhargoel8c
          </a>
        </li>
        <li>
          <a class="icon-trigger" href="https://www.linkedin.com/in/prakgoel89" target="_blank" rel="noopener">
            <PixelIcon name="linkedin" /> linkedin.com/in/prakgoel89
          </a>
        </li>
      </ul>
    </div>
  </main>
</CrtLayout>

<style>
  .page-title {
    font-size: clamp(1.4rem, 4.5vw, 2.4rem);
    margin-top: 1rem;
  }

  .player-card dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem 1.5rem;
  }

  .player-card dt {
    font-size: 0.6rem;
    color: var(--amber);
    margin-bottom: 0.3rem;
  }

  /* XP bar */
  .xp {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 1.4rem;
    flex-wrap: wrap;
  }

  .xp-label {
    font-size: 0.7rem;
    color: var(--amber-hi);
  }

  .xp-bar {
    flex: 1;
    min-width: 160px;
    height: 16px;
    border: 2px solid rgba(160, 150, 255, 0.4);
    background: rgba(18, 11, 38, 0.6);
    padding: 2px;
  }

  .xp-fill {
    height: 100%;
    width: 78%;
    background: repeating-linear-gradient(
      90deg,
      var(--amber) 0 8px,
      var(--amber-hi) 8px 16px
    );
  }

  @media (prefers-reduced-motion: no-preference) {
    .xp-fill {
      animation: xp-fill 1.2s steps(12) both;
    }
    @keyframes xp-fill {
      from { width: 0; }
      to { width: 78%; }
    }
  }

  .xp-note {
    font-size: 1.05rem;
  }

  .bio {
    margin-top: 1.4rem;
    border-top: 1px dashed rgba(160, 150, 255, 0.35);
    padding-top: 1.2rem;
  }

  .map-hint {
    margin-bottom: 1rem;
  }

  /* Worlds */
  .world {
    margin-block: 1rem;
  }

  .world summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .world summary::-webkit-details-marker {
    display: none;
  }

  .world-name {
    font-size: clamp(0.65rem, 1.7vw, 0.85rem);
    color: var(--text);
    line-height: 1.7;
  }

  .world-name::before {
    content: '▶ ';
    color: var(--amber);
  }

  .world[open] .world-name::before {
    content: '▼ ';
    color: var(--coral);
  }

  .world summary:hover .world-name {
    color: var(--amber-hi);
  }

  .yc-badge {
    display: inline-block;
    margin-left: 0.6em;
    padding: 0.15em 0.45em;
    background: #f26522;
    color: #fff;
    font-size: 0.85em;
  }

  .world-meta {
    font-size: 1.05rem;
  }

  .status {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .status.active {
    color: var(--amber);
  }

  .world-blurb {
    margin-top: 1rem;
    border-top: 1px dashed rgba(160, 150, 255, 0.35);
    padding-top: 1rem;
  }

  .stage-block {
    margin-top: 1.5rem;
  }

  .stage-code {
    font-size: clamp(0.6rem, 1.5vw, 0.75rem);
    color: var(--amber);
    line-height: 1.7;
  }

  .stage-dates {
    margin: 0.35rem 0 0.7rem;
    font-size: 1.05rem;
  }

  .stage-block ul {
    list-style: none;
  }

  .stage-block li {
    padding-left: 1.4em;
    position: relative;
    margin-bottom: 0.5rem;
  }

  .stage-block li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--coral);
  }

  /* Loot */
  .loot {
    margin-top: 1.75rem;
    border-top: 1px dashed rgba(160, 150, 255, 0.35);
    padding-top: 1.25rem;
  }

  .loot-head {
    font-size: 0.6rem;
    color: var(--amber-hi);
    margin-bottom: 0.9rem;
  }

  .loot-head::before {
    content: '◆ ';
    color: var(--coral);
  }

  .loot-grid {
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  .loot-grid li {
    display: grid;
    gap: 0.3rem;
  }

  .item-name {
    font-size: 0.65rem;
    color: var(--text);
  }

  /* Skills, achievements, party */
  .skill-row {
    margin-bottom: 1.4rem;
  }
  .skill-row:last-child {
    margin-bottom: 0;
  }

  .skill-group {
    font-size: 0.6rem;
    color: var(--amber);
    margin-bottom: 0.6rem;
  }

  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chips li {
    border: 1px solid rgba(160, 150, 255, 0.4);
    padding: 0.1rem 0.6rem;
    font-size: 1.1rem;
  }

  .chips li.fresh {
    border-color: var(--amber);
  }

  .new-tag {
    font-size: 0.45rem;
    color: var(--amber-hi);
    margin-left: 0.5em;
    vertical-align: 0.2em;
  }

  .achievements {
    list-style: none;
  }

  .tutorial {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .tutorial li::before {
    content: '✓ ';
    color: var(--amber);
  }

  .achievements li {
    padding-left: 1.4em;
    position: relative;
    margin-bottom: 0.5rem;
  }

  .achievements li::before {
    content: '★';
    position: absolute;
    left: 0;
    color: var(--amber);
  }

  .party {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .party a {
    color: var(--amber);
    text-decoration-style: dotted;
    text-underline-offset: 4px;
  }

  /* phones only: desktop UX stays untouched */
  @media (max-width: 640px) {
    .page-title {
      margin-top: 0.5rem;
    }

    /* stack world name over its dates instead of pushing them apart */
    .world summary {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
      /* generous touch target without changing the visual box */
      padding: 0.6rem;
      margin: -0.6rem;
    }

    .party {
      gap: 0.9rem;
    }

    /* touch-friendly contact rows that never overflow */
    .party a {
      display: inline-block;
      padding: 0.35rem 0;
      overflow-wrap: anywhere;
    }
  }
</style>
